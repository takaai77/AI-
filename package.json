{
  "name": "playwright-automation-queue",
  "version": "1.0.0",
  "description": "Playwright自動化基盤 - Zendeskからジョブ投入、BullMQでキュー管理、スプレッドシートに記録",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "server": "ts-node src/server.ts",
    "worker": "ts-node src/worker.ts",
    "dev": "concurrently \"npm run server\" \"npm run worker\"",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.2",
    "playwright": "^1.40.0",
    "googleapis": "^129.0.0",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.2",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
