{
  "name": "sheets-worker-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Local PoC: Express internal API + Google Sheets job ledger + Playwright worker",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^150.0.1",
    "p-queue": "^8.1.0",
    "playwright": "^1.51.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
