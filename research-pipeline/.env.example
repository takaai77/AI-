# ===================================================
# サジー論文リサーチパイプライン - 環境変数設定例
# ===================================================
# このファイルを .env にコピーして実際の値を設定してください
# .env は絶対に Git にコミットしないでください（.gitignore に追加）

# ---------------------------------------------------
# API Keys（必須 / 推奨）
# ---------------------------------------------------

# PubMed E-utilities API Key（任意だが強く推奨）
# 取得: https://www.ncbi.nlm.nih.gov/account/ → Settings → API Key Management
# なし: 3リクエスト/秒制限 / あり: 10リクエスト/秒
PUBMED_API_KEY=your_pubmed_api_key_here

# Semantic Scholar API Key（任意だが推奨）
# 取得: https://www.semanticscholar.org/product/api でリクエスト
# なし: 100件/5分制限
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Anthropic Claude API Key（必須）
# 取得: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Chatwork API Token（必須 - 通知に使用）
# 取得: Chatwork設定 → API Token
CHATWORK_API_TOKEN=your_chatwork_api_token_here

# Google Service Account JSON（必須 - Sheets書き込みに使用）
# 取得: GCPコンソール → IAM → サービスアカウント → JSONキー作成
# 注意: JSON全体を1行の文字列として設定
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ---------------------------------------------------
# ID 設定
# ---------------------------------------------------

# Chatwork 通知先ルームID
# 確認方法: Chatworkでルームを開き、URLの末尾の数字
CHATWORK_ROOM_ID=123456789

# Google Sheets スプレッドシートID
# 確認方法: SheetsのURL → .../spreadsheets/d/{この部分}/edit
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ---------------------------------------------------
# 動作設定（任意）
# ---------------------------------------------------

# Claude AIモデル（デフォルト: claude-opus-4-6）
CLAUDE_MODEL=claude-opus-4-6

# Chatwork通知する最低スコア（1-10, デフォルト: 7）
NOTIFICATION_THRESHOLD=7

# 何日前までの論文を取得するか（デフォルト: 7）
SEARCH_DAYS=7

# Baidu Scholar取得を有効にするか（Phase 2用, デフォルト: false）
# Cloud Runへのデプロイ後に true に変更
ENABLE_BAIDU=false
