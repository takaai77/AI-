# ===========================================
# Playwright自動化基盤 環境変数設定
# ===========================================
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# -------------------------------------------
# サーバー設定
# -------------------------------------------
# APIサーバーのポート番号
PORT=3000

# 本番環境では "production" に設定
NODE_ENV=development

# -------------------------------------------
# Redis設定（BullMQキュー用）
# -------------------------------------------
# Redisホスト名（ローカル開発時は localhost）
REDIS_HOST=localhost

# Redisポート番号（デフォルト: 6379）
REDIS_PORT=6379

# Redisパスワード（設定していない場合は空欄）
REDIS_PASSWORD=

# Redis URL形式で指定する場合（Cloud Run等で使用）
# REDIS_URL=redis://:password@host:port

# -------------------------------------------
# Googleスプレッドシート設定
# -------------------------------------------
# 記録用スプレッドシートのID（URLの /d/ と /edit の間の部分）
# 例: https://docs.google.com/spreadsheets/d/XXXXXX/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# サービスアカウントの認証情報JSONファイルのパス
# Cloud Runでは環境変数GOOGLE_CREDENTIALS_JSONに直接JSONを入れることも可能
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# 認証情報をJSON文字列として直接指定する場合（Cloud Run向け）
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# -------------------------------------------
# たまごリピート設定
# -------------------------------------------
# たまごリピート管理画面のベースURL
TAMAGO_BASE_URL=https://example.tamago-repeat.jp/admin

# ログイン情報（本番では Secret Manager 等を使用推奨）
TAMAGO_LOGIN_ID=your_login_id
TAMAGO_LOGIN_PASSWORD=your_password

# -------------------------------------------
# Playwright設定
# -------------------------------------------
# ヘッドレスモード（true: ブラウザ非表示, false: 表示）
PLAYWRIGHT_HEADLESS=true

# ブラウザタイプ（chromium, firefox, webkit）
PLAYWRIGHT_BROWSER=chromium

# 操作タイムアウト（ミリ秒）
PLAYWRIGHT_TIMEOUT=30000

# スクリーンショット保存先
ARTIFACTS_DIR=./artifacts

# ログイン状態を保存するファイル（再ログイン省略用）
STORAGE_STATE_PATH=./storageState.json

# -------------------------------------------
# ジョブ設定
# -------------------------------------------
# キューの同時実行数（最大10）
QUEUE_CONCURRENCY=10

# ジョブの最大リトライ回数
JOB_MAX_ATTEMPTS=3

# リトライ時の初期待機時間（ミリ秒）
JOB_BACKOFF_DELAY=5000

# -------------------------------------------
# ロック設定（同一顧客+アクションの同時実行防止）
# -------------------------------------------
# ロックの有効期限（ミリ秒）
LOCK_TTL=300000

# -------------------------------------------
# ログ設定
# -------------------------------------------
# ログレベル（debug, info, warn, error）
LOG_LEVEL=info

# -------------------------------------------
# セキュリティ設定
# -------------------------------------------

# 内部APIの認証キー（設定すると X-Internal-API-Key ヘッダーが必要）
# 64文字以上のランダムな文字列を推奨
# 生成コマンド: openssl rand -hex 32
INTERNAL_API_KEY=

# JWT認証設定（JWT認証を有効にする場合に設定）
# 最低32文字の秘密鍵
# 生成コマンド: openssl rand -base64 48
JWT_SECRET=

# JWTトークンの有効期限（秒）デフォルト: 3600（1時間）
JWT_EXPIRES_IN=3600

# 管理者シークレット（トークン発行・APIキー生成に必要）
# 64文字以上のランダムな文字列を推奨
ADMIN_SECRET=

# -------------------------------------------
# IPホワイトリスト設定
# -------------------------------------------
# 許可するIPアドレス（カンマ区切り）
# CIDR表記も可能（例: 10.0.0.0/8）
# 空欄の場合は全IPを許可
IP_WHITELIST=

# -------------------------------------------
# レート制限設定
# -------------------------------------------
# レート制限を有効にする（true/false）デフォルト: true
RATE_LIMIT_ENABLED=true

# レート制限のウィンドウサイズ（ミリ秒）デフォルト: 60000（1分）
RATE_LIMIT_WINDOW_MS=60000

# ウィンドウ内の最大リクエスト数 デフォルト: 100
RATE_LIMIT_MAX_REQUESTS=100

# -------------------------------------------
# 監査ログ設定
# -------------------------------------------
# 監査ログの出力先（console, file）デフォルト: console
AUDIT_LOG_OUTPUT=console

# 監査ログのディレクトリ（file出力時）
AUDIT_LOG_DIR=./logs
